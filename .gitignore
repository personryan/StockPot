# ============================================
# Go
# ============================================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Coverage / test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace
go.work
go.work.sum

# Optional vendored dependencies
# vendor/


# ============================================
# Angular / Node
# ============================================

# Dependencies
node_modules/

# Angular build output
dist/

# Angular cache
.angular/

# Coverage
coverage/

# Temporary files
.tmp/
temp/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/
.pnpm-store/


# ============================================
# Environment / Secrets
# ============================================

.env
.env.*
!.env.example

# Supabase / local secrets
*.local


# ============================================
# IDE / Editors
# ============================================

.idea/
.vscode/

# Optional: keep shared VS Code configuration
# If you later want to commit .vscode settings,
# remove .vscode/ above and selectively ignore files instead.


